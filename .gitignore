node_modules/**
# The master plan stays private; the per-phase roadmaps are tracked.
roadmap/00-*
.ghidra/
.ghidra-home/
.claude/
.certs/

dist/
# Copied from the repository root by the build so the package carries its own.
modules/core/LICENSE
modules/core/THIRD-PARTY-NOTICES.md
tools/cdp_test/reports/
*.log
# No trailing slash: a symlink at this path (a worktree pointing at the main
# checkout's artifacts) is ignored too, not committed.
modules/core/vendor/prebuilt

# Game bundles built locally: gigabytes of someone else's data.
bundles/

# Local reverse-engineering tools: a Ghidra install, extracted binaries, caches.
.tools/

# Game installers downloaded for bring-up testing: gigabytes of someone else's data.
.to_install/

# Frames and textures dumped out of a running game to be looked at: someone
# else's artwork, and megabytes of it.
dbg/

# The nasm corpus the translator tests fetch, pinned by modules/cork/corpus-lock.json.
# No trailing slash, as for the prebuilt artifacts above: a link here is ignored too.
modules/cork/vendor

# AppleDouble files the host writes on the shared checkout
._*
