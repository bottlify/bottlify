{
  "name": "bottlify",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "modules/*"
  ],
  "scripts": {
    "build": "npm run build -w @bottlify/core",
    "build:v86": "npm run build:v86 -w @bottlify/core --",
    "build:video-decoder": "npm run build:video-decoder -w @bottlify/core --",
    "build:zstd": "npm run build:zstd -w @bottlify/core --",
    "build:vendor": "npm run build:v86 -- --docker && npm run build:video-decoder -- --docker && npm run build:zstd -- --docker",
    "fetch:v86": "npm run fetch:v86 -w @bottlify/core",
    "fetch:corpus": "npm run fetch:corpus -w @bottlify/cork",
    "fetch:video-decoder": "npm run fetch:video-decoder -w @bottlify/core",
    "fetch:zstd": "npm run fetch:zstd -w @bottlify/core",
    "verify:reproducibility": "npm run verify:reproducibility -w @bottlify/core",
    "typecheck": "npm run typecheck -w @bottlify/core && npm run typecheck -w @bottlify/networking && npm run typecheck -w @bottlify/installer && npm run typecheck -w @bottlify/cork",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w @bottlify/core && npm run test -w @bottlify/networking && npm run test -w @bottlify/installer && npm run test -w @bottlify/cork",
    "test:integration": "npm run test:integration -w @bottlify/core",
    "test:tools": "node --test \"tools/**/*.test.js\"",
    "check:boundaries": "npm run check:boundaries -w @bottlify/core",
    "cdp:probe": "node tools/cdp_test/cli.mjs probe",
    "cdp:game": "node tools/cdp_test/game.mjs",
    "cdp:frames": "node tools/cdp_test/frames.mjs",
    "ui": "npm --prefix ../bottlify-ui start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "typescript": "^5.7.2"
  }
}