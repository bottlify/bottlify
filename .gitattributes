# C sources are compiled reproducibly and their bytes hashed (interp-wasm.c's
# SHA-256 is recorded beside the module built from it), so a checkout under
# core.autocrlf must not hand them over with CRLF line ends.
*.c text eol=lf
*.h text eol=lf

# The guest routines `npm run build` writes beside their JavaScript come out
# with LF line ends; under core.autocrlf a checkout's CRLF made every build
# show them as changed when nothing in them was.
*.x86.js text eol=lf
*.x64.js text eol=lf
