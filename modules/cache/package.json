{
  "name": "@bottlify/cache",
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "One cache for every thread of a page: bodies in shared memory read in place by name, one budget, idle bodies on OPFS",
  "homepage": "https://github.com/bottlify/bottlify/tree/main/modules/cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/bottlify.git",
    "directory": "modules/cache"
  },
  "bugs": {
    "url": "https://github.com/bottlify/bottlify/issues"
  },
  "keywords": [
    "cache",
    "sharedarraybuffer",
    "opfs",
    "workers",
    "browser"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.itest.js",
    "!src/**/*.fixture.js",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 \"src/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=600000 \"src/**/*.itest.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "publishConfig": {
    "access": "public"
  }
}
