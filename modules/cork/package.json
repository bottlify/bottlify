{
  "name": "@bottlify/cork",
  "version": "1.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Cork: a user-mode x86 to WebAssembly translator, the execution engine @bottlify/core's cpu layer loads by URL",
  "homepage": "https://github.com/bottlify/bottlify/tree/main/modules/cork#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/bottlify.git",
    "directory": "modules/cork"
  },
  "bugs": {
    "url": "https://github.com/bottlify/bottlify/issues"
  },
  "keywords": [
    "x86",
    "webassembly",
    "wasm",
    "translator",
    "emulator",
    "jit"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cork": "./bin/cork.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./wasm": "./src/wasm/encoder.js",
    "./runtime": "./src/runtime/runtime.js",
    "./machine": "./src/machine.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.itest.js",
    "!src/**/*.gz",
    "bin",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=1200000 \"src/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=1800000 \"src/**/*.itest.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "version": "node scripts/stamp-version.mjs && git add src/version.js",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "publishConfig": {
    "access": "public"
  }
}
