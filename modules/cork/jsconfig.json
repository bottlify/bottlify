{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "punycode": [
        "../core/types/punycode.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "bin/*.mjs",
    "../core/types/build.d.ts"
  ]
}
