# Pinned compiler image for the wasm interpreter (`build-interp-wasm.mjs
# --docker`): Debian bookworm's clang-16 and lld-16, nothing else. The pin is
# what makes the output a function of the source alone.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends clang-16 lld-16 \
 && rm -rf /var/lib/apt/lists/*
