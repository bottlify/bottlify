{
  "name": "@bottlify/installer",
  "version": "1.0.1",
  "type": "module",
  "license": "MPL-2.0",
  "description": "Adding a title by running its installer: the temp prefix, what it leaves behind, and the way that travels to a bottle server",
  "homepage": "https://github.com/bottlify/bottlify/tree/main/modules/installer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/bottlify.git",
    "directory": "modules/installer"
  },
  "bugs": {
    "url": "https://github.com/bottlify/bottlify/issues"
  },
  "keywords": [
    "installer",
    "windows",
    "browser",
    "bottle",
    "bundle"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./prefix": "./src/prefix.js",
    "./silent": "./src/silent.js",
    "./disc": "./src/disc.js",
    "./pack": "./src/pack.js",
    "./upload": "./src/upload.js",
    "./server": "./src/server/index.js"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.itest.js",
    "!src/**/*.fixture.js",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=60000 \"src/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=60000 \"src/**/*.itest.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "bottles": "node src/server/cli.js",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "@bottlify/core": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
