# Pinned build image for the vendored v86. Version pins are what make the
# make-all output reproducible; bump them only together with manifest.json.
#
# Toolchain required by vendor/v86's own Makefile (not just "rustc"):
#   - node    → gen/generate_{jit,interpreter,analyzer}.js (shebang #!/usr/bin/env node)
#   - default-jre-headless + wget → java -jar closure-compiler, fetched by the
#     Makefile's own `$(CLOSURE):` rule on first use
#   - clang   → build/{softfloat,zstddeclib}.o (compiled with --target=wasm32)
#   - python3 → tools/rust-lld-wrapper
#   - wasm32-unknown-unknown rust target → cargo rustc --target wasm32-unknown-unknown
#
# The Rust floor is set by what v86's own sources use, and it moves: `&raw const`
# (1.82), strict provenance (1.84) and `integer_sign_cast` (1.87) are all in the
# CPU core. Upstream builds against whatever `stable` happens to be, so a bump of
# the submodule can raise this floor without anything in v86 saying so -- the
# symptom is a wall of E0658 out of `cargo`, and the fix is here rather than in
# the sources.
FROM rust:1.98-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends make clang python3 nodejs wget default-jre-headless \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add wasm32-unknown-unknown

COPY v86-make-and-hash.sh /usr/local/bin/v86-make-and-hash.sh
RUN chmod +x /usr/local/bin/v86-make-and-hash.sh

ENTRYPOINT ["v86-make-and-hash.sh"]