# Pinned build image for zstd.wasm: this project's own decode-only zstd
# (scripts/zstd/zstd.c) compiled to WebAssembly with clang and wasm-ld.
#
# One pin makes the output reproducible and it lives here: the compiler
# version (Debian bookworm's clang-16 and lld-16). The same source through the
# same compiler gives the same bytes, which `verify:reproducibility` checks the
# way it checks the emulator. No libc, no crates, no clone: the source is in
# the repository and the image carries nothing but the compiler.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends clang-16 lld-16 \
 && rm -rf /var/lib/apt/lists/*

COPY zstd/build-zstd.sh /usr/local/bin/build-zstd.sh
RUN chmod +x /usr/local/bin/build-zstd.sh

COPY zstd/zstd.c /opt/zstd/zstd.c

ENV CLANG=clang-16
ENTRYPOINT ["build-zstd.sh", "/opt/zstd/zstd.c"]
