{
  "name": "@bottlify/core",
  "version": "2.0.0a",
  "description": "Run original Win32 x86 programs in the browser: x86 translated to WebAssembly plus a from-scratch Win32/DirectX layer on WebGPU, WebAudio and OPFS.",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://github.com/bottlify/bottlify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/bottlify.git",
    "directory": "modules/core"
  },
  "bugs": {
    "url": "https://github.com/bottlify/bottlify/issues"
  },
  "keywords": [
    "win32",
    "x86",
    "directx",
    "direct3d",
    "webgpu",
    "wine",
    "browser"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/core.js",
    "./bundle": "./src/bundle.js",
    "./bundle/node": "./src/bundle-node.js",
    "./iso": "./src/iso.js",
    "./jpeg": "./src/layers/media/internal/jpeg.js",
    "./engine.worker.js": "./dist/engine.worker.js",
    "./worklet.js": "./dist/worklet.js",
    "./video-decoder.wasm": "./dist/vendor/video-decoder.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "src/layers/audio/asi/minimp3.LICENSE",
    "src/bundle.js",
    "src/bundle-node.js",
    "src/layers/filesystem/internal/bundle/format.js",
    "src/layers/filesystem/internal/bundle/crc32.js",
    "src/iso.js",
    "src/layers/filesystem/internal/iso/iso9660.js",
    "src/layers/filesystem/internal/paths.js",
    "src/layers/filesystem/internal/errors.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:video-decoder": "node scripts/build-video-decoder.mjs",
    "build:zstd": "node scripts/build-zstd.mjs",
    "build:guest-code": "node scripts/build-guest-code.mjs",
    "fetch:video-decoder": "node scripts/fetch-video-decoder.mjs",
    "fetch:zstd": "node scripts/fetch-zstd.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test --test-timeout=60000 \"src/**/*.test.js\" \"scripts/**/*.test.js\" \"test/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=60000 \"src/**/*.itest.js\"",
    "prepublishOnly": "npm run build && npm run check:package"
  }
}
