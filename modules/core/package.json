{
  "name": "@bottlify/core",
  "version": "0.1.0",
  "description": "Run original Win32 x86 programs in the browser: x86 emulation plus a from-scratch Win32/DirectX layer on WebGPU, WebAudio and OPFS.",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://github.com/mrwayer/bottlify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrwayer/bottlify.git",
    "directory": "modules/core"
  },
  "bugs": {
    "url": "https://github.com/mrwayer/bottlify/issues"
  },
  "keywords": [
    "win32",
    "x86",
    "emulator",
    "v86",
    "directx",
    "direct3d",
    "webgpu",
    "wine",
    "browser"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/core.js",
    "./engine.worker.js": "./dist/engine.worker.js",
    "./worklet.js": "./dist/worklet.js",
    "./libv86.mjs": "./dist/vendor/libv86.mjs",
    "./v86.wasm": "./dist/vendor/v86.wasm",
    "./video-decoder.wasm": "./dist/vendor/video-decoder.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:v86": "node scripts/build-v86.mjs",
    "build:video-decoder": "node scripts/build-video-decoder.mjs",
    "fetch:v86": "node scripts/fetch-v86.mjs",
    "fetch:video-decoder": "node scripts/fetch-video-decoder.mjs",
    "verify:reproducibility": "node scripts/verify-reproducibility.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test \"src/**/*.test.js\"",
    "test:integration": "node --test \"src/**/*.itest.js\"",
    "prepublishOnly": "npm run build && npm run check:package"
  }
}
