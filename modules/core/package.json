{
  "name": "@bottlify/core",
  "version": "1.0.2",
  "description": "Run unchanged Windows programs and games in a browser tab, on a Windows environment written from scratch over WebGPU, Web Audio and OPFS.",
  "type": "module",
  "license": "MPL-2.0",
  "homepage": "https://github.com/bottlify/bottlify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlify/bottlify.git",
    "directory": "modules/core"
  },
  "bugs": {
    "url": "https://github.com/bottlify/bottlify/issues"
  },
  "keywords": [
    "win32",
    "x86",
    "directx",
    "direct3d",
    "webgpu",
    "wine",
    "browser"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/core.js",
    "./bundle": "./src/bundle.js",
    "./bundle/node": "./src/bundle-node.js",
    "./iso": "./src/iso.js",
    "./programs": "./src/layers/win32/programs/table.js",
    "./storage": "./src/storage.js",
    "./jpeg": "./src/layers/media/internal/jpeg.js",
    "./engine.worker.js": "./dist/engine.worker.js",
    "./worklet.js": "./dist/worklet.js",
    "./video-decoder.wasm": "./dist/vendor/video-decoder.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "src/layers/audio/asi/minimp3.LICENSE",
    "src/bundle-node.js",
    "src/bundle.js",
    "src/iso.js",
    "src/layers/cpu/internal/translation-store.js",
    "src/layers/filesystem/internal/bundle/cache.js",
    "src/layers/filesystem/internal/bundle/crc32.js",
    "src/layers/filesystem/internal/bundle/format.js",
    "src/layers/filesystem/internal/errors.js",
    "src/layers/filesystem/internal/iso/build.js",
    "src/layers/filesystem/internal/iso/iso9660.js",
    "src/layers/filesystem/internal/opfs-store.js",
    "src/layers/filesystem/internal/paths.js",
    "src/layers/loader/internal/pe.js",
    "src/layers/loader/internal/resources.js",
    "src/layers/loader/internal/synth.js",
    "src/layers/media/internal/jpeg.js",
    "src/layers/win32/advapi32/registry.js",
    "src/layers/win32/common/refusal.js",
    "src/layers/win32/dsetup/functions.js",
    "src/layers/win32/kernel32/languages.js",
    "src/layers/win32/kernel32/locale.js",
    "src/layers/win32/kernel32/processor.js",
    "src/layers/win32/kernel32/versions.js",
    "src/layers/win32/lz32/expand.js",
    "src/layers/win32/ntdll/status.js",
    "src/layers/win32/programs/command-line.js",
    "src/layers/win32/programs/msiexec.js",
    "src/layers/win32/programs/notepad.js",
    "src/layers/win32/programs/regsvr32.js",
    "src/layers/win32/programs/rundll32.js",
    "src/layers/win32/programs/table.js",
    "src/layers/win32/version/functions.js",
    "src/storage.js",
    "src/zstd.js"
  ],
  "dependencies": {
    "@bottlify/cork": "~1.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:video-decoder": "node scripts/build-video-decoder.mjs",
    "build:zstd": "node scripts/build-zstd.mjs",
    "build:guest-code": "node scripts/build-guest-code.mjs",
    "fetch:video-decoder": "node scripts/fetch-video-decoder.mjs",
    "fetch:zstd": "node scripts/fetch-zstd.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-thread-after-await.mjs && node scripts/check-deterministic-math.mjs && node scripts/check-link-handlers.mjs",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test --test-timeout=180000 \"src/**/*.test.js\" \"scripts/**/*.test.js\" \"test/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=180000 \"src/**/*.itest.js\"",
    "prepublishOnly": "npm run build && npm run check:package"
  }
}
